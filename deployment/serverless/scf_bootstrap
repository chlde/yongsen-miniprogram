#!/bin/sh
set -eu
umask 077

fail() {
    printf '%s\n' "SCF configuration error: $1" >&2
    exit 1
}
required() {
    [ -n "$2" ] || fail "$1 is required in the private runtime configuration."
}
https_origin() {
    printf '%s' "$2" | grep -Eq '^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?/?$' \
        || fail "$1 must be an HTTPS origin without credentials, port, path or query."
    case "$2" in *localhost*|*127.0.0.1*|*example.*|*.local|*.invalid) fail "$1 must use an actual production domain." ;; esac
}

case "$#:$*" in 0:|1:--check) ;; *) fail 'Only --check is accepted; command overrides are forbidden.' ;; esac
[ "${SPRING_PROFILES_ACTIVE:-serverless}" = serverless ] || fail 'SPRING_PROFILES_ACTIVE must be serverless.'
[ "${WECHAT_MODE:-real}" = real ] || fail 'WECHAT_MODE must be real.'
[ "${TRAINING_STORAGE_MODE:-cos}" = cos ] || fail 'TRAINING_STORAGE_MODE must be cos.'
[ "${TRAINING_BACKGROUND_MODE:-scf}" = scf ] || fail 'TRAINING_BACKGROUND_MODE must be scf.'
required TRAINING_MYSQL_URL "${TRAINING_MYSQL_URL:-}"
case "$TRAINING_MYSQL_URL" in jdbc:mysql://*) ;; *) fail 'TRAINING_MYSQL_URL must use MySQL JDBC.' ;; esac
case "$TRAINING_MYSQL_URL" in jdbc:mysql://localhost[:/]*|jdbc:mysql://127.*|jdbc:mysql://\[::1\]*) fail 'Use the managed MySQL private address.' ;; esac
required TRAINING_MYSQL_USER "${TRAINING_MYSQL_USER:-}"
[ "$TRAINING_MYSQL_USER" != root ] || fail 'Use a least-privileged business database account.'
required TRAINING_MYSQL_PASSWORD "${TRAINING_MYSQL_PASSWORD:-}"
required WECHAT_APPID "${WECHAT_APPID:-}"
printf '%s' "$WECHAT_APPID" | grep -Eq '^wx[0-9a-fA-F]{16}$' || fail 'WECHAT_APPID is invalid.'
required WECHAT_APP_SECRET "${WECHAT_APP_SECRET:-}"
required TRAINING_DATA_KEY "${TRAINING_DATA_KEY:-}"
[ "${#TRAINING_DATA_KEY}" -ge 32 ] || fail 'TRAINING_DATA_KEY requires at least 32 characters.'
case "$TRAINING_DATA_KEY" in local-only*) fail 'The local data key is forbidden.' ;; esac
required TRAINING_ADMIN_PASSWORD "${TRAINING_ADMIN_PASSWORD:-}"
[ "${#TRAINING_ADMIN_PASSWORD}" -ge 12 ] && [ "$TRAINING_ADMIN_PASSWORD" != 'LocalTrain123!' ] \
    || fail 'A non-local administrator password of at least 12 characters is required.'
required TRAINING_WORKER_SECRET "${TRAINING_WORKER_SECRET:-}"
printf '%s' "$TRAINING_WORKER_SECRET" | grep -Eq '^[A-Za-z0-9_-]{43,128}$' \
    || fail 'TRAINING_WORKER_SECRET must be a 32-byte-or-longer random base64url value.'
required TRAINING_PUBLIC_BASE "${TRAINING_PUBLIC_BASE:-}"
https_origin TRAINING_PUBLIC_BASE "$TRAINING_PUBLIC_BASE"
required TRAINING_COS_BUCKET "${TRAINING_COS_BUCKET:-}"
printf '%s' "$TRAINING_COS_BUCKET" | grep -Eq '^[a-z0-9][a-z0-9-]*-[0-9]+$' || fail 'TRAINING_COS_BUCKET is invalid.'
required TRAINING_COS_REGION "${TRAINING_COS_REGION:-}"
required TRAINING_SCF_REGION "${TRAINING_SCF_REGION:-}"
[ "$TRAINING_COS_REGION" = "$TRAINING_SCF_REGION" ] || fail 'COS and SCF must share a region for this deployment.'
required TRAINING_SCF_WORKER_FUNCTION "${TRAINING_SCF_WORKER_FUNCTION:-}"
printf '%s' "$TRAINING_SCF_WORKER_FUNCTION" | grep -Eq '^[A-Za-z][A-Za-z0-9_-]{0,58}[A-Za-z0-9]$' \
    || fail 'TRAINING_SCF_WORKER_FUNCTION is invalid.'
required TRAINING_TENCENT_SECRET_ID "${TRAINING_TENCENT_SECRET_ID:-}"
required TRAINING_TENCENT_SECRET_KEY "${TRAINING_TENCENT_SECRET_KEY:-}"

# This custom image uses explicit least-privileged CAM runtime credentials.
# SCF image-role credentials arrive in platform headers, not environment variables;
# this application deliberately does not trust incoming credential headers.
# Never copy credentials into the image or pass them through command arguments.
export SPRING_PROFILES_ACTIVE=serverless WECHAT_MODE=real TRAINING_STORAGE_MODE=cos TRAINING_BACKGROUND_MODE=scf
export SERVER_ADDRESS=0.0.0.0 SERVER_PORT=9000 SPRING_SQL_INIT_MODE=never TRAINING_DATA_DIR=/tmp/yongsen-training
export SPRING_DATASOURCE_TYPE=org.springframework.jdbc.datasource.DriverManagerDataSource
export SPRING_DATASOURCE_URL="$TRAINING_MYSQL_URL" SPRING_DATASOURCE_USERNAME="$TRAINING_MYSQL_USER"
export SPRING_DATASOURCE_PASSWORD="$TRAINING_MYSQL_PASSWORD"
if [ "${1:-}" = --check ]; then
    printf '%s\n' 'SCF runtime configuration validated; no network requests or cloud changes were made.'
    exit 0
fi
for binary in java "${FFPROBE_PATH:-ffprobe}" "${PDFINFO_PATH:-pdfinfo}" "${PDFTOPPM_PATH:-pdftoppm}"; do
    command -v "$binary" > /dev/null 2>&1 || fail 'A required runtime binary is unavailable.'
done
[ -r /opt/yongsen/app.jar ] || fail 'The packaged application is missing.'
mkdir -p "$TRAINING_DATA_DIR"
# Avoid the JVM echoing administrator-supplied option strings into cloud logs.
unset JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS
exec java -XX:MaxRAMPercentage=60.0 -Djava.awt.headless=true -Dfile.encoding=UTF-8 -jar /opt/yongsen/app.jar
