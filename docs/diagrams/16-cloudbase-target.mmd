        Data[("云数据库<br/>角色、任务、进度、记录<br/>安全规则限制访问")]
        Files[("私有云存储<br/>视频、PDF、页图<br/>固定教材版本")]
    end
    WeChat["微信平台 · 外部系统<br/>向订阅用户发送任务提醒"]
    Mini -->|"SDK 查询与建立监听"| Data
    Mini -->|"callFunction 提交操作"| Functions
    Mini -->|"授权后直接上传与读取"| Files
    Functions -->|"事务读写"| Data
    Functions -->|"授权与文件处理"| Files
    Functions -->|"云调用发送订阅消息"| WeChat
