page{background:#f5f7fb;color:#172b45;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,button,text,input{box-sizing:border-box}button{font-size:28rpx;border-radius:16rpx}button::after{border:0}.screen{padding:32rpx 28rpx 56rpx}.eyebrow{font-size:21rpx;font-weight:600;letter-spacing:2rpx;color:#64748b}.title{font-size:44rpx;font-weight:700;line-height:1.35;margin:12rpx 0}.subtitle{color:#64748b;font-size:25rpx}.card{background:#fff;border:1rpx solid #e2e8f0;border-radius:20rpx;padding:28rpx;margin-top:24rpx}.section-title{font-size:30rpx;font-weight:650;margin-bottom:14rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack{display:flex;flex-direction:column;gap:10rpx}.grow{flex:1;min-width:0}.primary{background:#2563eb;color:#fff;font-weight:600;margin-top:22rpx;padding:7rpx 24rpx}.secondary{background:#edf3ff;color:#1d4ed8;margin-top:16rpx;border:1rpx solid #dbe7ff}.quiet{background:transparent;color:#2563eb;font-size:25rpx;padding:0;margin:0}.tag{display:inline-block;background:#eff4fc;color:#345783;padding:6rpx 14rpx;border-radius:8rpx;font-size:22rpx;white-space:nowrap}.tag.warn{background:#fff4df;color:#946200}.tag.done{background:#eaf1ff;color:#2455a4}.muted{color:#64748b;font-size:24rpx}.input{width:100%;height:92rpx;padding:0 24rpx;border:1rpx solid #ccd6e3;border-radius:16rpx;background:#fff;margin:16rpx 0}.notice{padding:20rpx 22rpx;background:#fff8e8;border:1rpx solid #eee1bf;border-radius:16rpx;color:#7c601e;font-size:24rpx;margin-top:20rpx}.error{background:#fff1f0;border-color:#f1d4d1;color:#a3473c}.empty{text-align:center;padding:50rpx 24rpx;color:#64748b}.empty-title{font-size:29rpx;font-weight:600;color:#334155;margin:18rpx 0 8rpx}.divider{height:1rpx;background:#e8edf4;margin:22rpx 0}.hero{padding:30rpx;border-radius:20rpx;background:#102b4e;color:#fff}.hero .subtitle{color:#c5d3e6}.hero .eyebrow{color:#a9c4e9}.pill{display:inline-block;border-radius:8rpx;padding:6rpx 15rpx;background:#ffffff12;color:#e5efff;font-size:22rpx}.link{color:#2563eb}.footer-note{font-size:22rpx;color:#77869a;line-height:1.75;margin:26rpx 4rpx}.bold{font-weight:600}.spinner{padding:34rpx;text-align:center;color:#64748b}.actions{display:flex;gap:16rpx;margin-top:20rpx}.actions button{flex:1;margin:0}.progress-track{height:8rpx;background:#e9eef7;border-radius:8rpx;overflow:hidden;margin-top:16rpx}.progress-fill{height:100%;background:#2563eb;border-radius:8rpx}.checkbox-row{display:flex;align-items:flex-start;gap:14rpx;font-size:25rpx}.small{font-size:23rpx}button[disabled]{opacity:.55}.section-heading{margin-top:34rpx}.section-heading .section-title{margin:0}.icon-tile{width:64rpx;height:64rpx;border-radius:14rpx;background:#eff4fc;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#2563eb}.line-icon{position:relative;display:inline-block;width:30rpx;height:34rpx;border:2rpx solid currentColor;border-radius:3rpx}.line-icon::before,.line-icon::after{position:absolute;content:"";display:block}.icon-book::before{left:12rpx;top:0;bottom:0;border-left:2rpx solid currentColor}.icon-document::before{left:6rpx;right:6rpx;top:9rpx;border-top:2rpx solid currentColor}.icon-document::after{left:6rpx;right:6rpx;top:19rpx;border-top:2rpx solid currentColor}.icon-video{width:34rpx;height:28rpx;border-radius:5rpx}.icon-video::before{width:10rpx;height:10rpx;left:9rpx;top:6rpx;border-right:2rpx solid currentColor;border-top:2rpx solid currentColor;transform:rotate(45deg)}.empty .icon-tile{margin:0 auto}.arrow{font-size:32rpx;color:#8394aa}
