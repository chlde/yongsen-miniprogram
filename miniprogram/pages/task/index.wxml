<view class="screen">
  <view wx:if="{{loading}}" class="spinner">正在读取任务…</view>
  <view wx:if="{{error}}" class="notice error" bindtap="load">{{error}} · 点击重试</view>
  <block wx:if="{{task}}">
    <view class="task-heading"><view class="eyebrow">企业培训 · 学习任务</view><view class="title">{{task.title}}</view>
    <view class="row"><text class="tag {{task.status === 'COMPLETED' ? 'done' : ''}}">{{task.stateLabel}}</text><text wx:if="{{task.overdue}}" class="tag warn">逾期可补学</text></view>
    <view class="muted" style="margin-top:22rpx">截止 {{task.dueLabel}}</view><view wx:if="{{task.description}}" class="task-description">{{task.description}}</view></view>
    <view wx:if="{{task.taskStatus === 'CANCELED' || task.taskStatus === 'CANCELLED'}}" class="notice">任务已取消，历史记录保留，不能继续学习。</view>
    <view class="card reminder-card">
      <view class="muted" style="margin-top:12rpx">主动订阅后可接收本次任务提醒。一次订阅不等于永久授权；未订阅也能在待办中学习。</view>
      <button id="subscribe-button" class="secondary" loading="{{subscribing}}" bindtap="subscribe">订阅微信任务通知</button>
    </view>
    <view class="section-title" style="margin-top:32rpx">培训内容</view>
    <view wx:for="{{task.materials}}" wx:key="taskMaterialId" class="card material-card" data-id="{{item.taskMaterialId || item.id}}" bindtap="openMaterial">
      <view class="row"><text class="tag">{{item.typeLabel}}</text><text class="tag {{item.done ? 'done' : ''}}">{{item.done ? '已达到要求' : '待完成'}}</text></view>
      <view class="material-head"><view class="icon-tile"><view class="line-icon {{item.isVideo ? 'icon-video' : 'icon-document'}}"></view></view><view class="grow"><view class="material-title">{{item.title}}</view><view class="muted">{{item.subtitle}}</view></view></view>
      <view class="progress-track"><view class="progress-fill" style="width:{{item.coveragePercent}}%"></view></view>
      <view class="row" style="margin-top:16rpx"><text class="muted">学习覆盖 {{item.coveragePercent}}%</text><text class="link">{{item.done ? '再次查看' : '开始 / 继续'}} →</text></view>
    </view>
    <view wx:if="{{task.status === 'COMPLETED'}}" class="card"><view class="section-title">本人确认已保存</view><view class="muted">确认时间：{{task.completedLabel}}</view><view class="footer-note">记录反映系统学习要求的完成情况，不表示取得行业资质或操作考核合格。</view></view>
    <view wx:elif="{{task.requirementsMet || task.status === 'READY_TO_CONFIRM'}}" class="card confirmation-card">
      <view class="section-title">完成学习 · 本人确认</view>
      <checkbox-group bindchange="onAccept"><label class="checkbox-row"><checkbox id="confirmation-checkbox" value="accepted" checked="{{accepted}}" color="#2563eb" /><text>{{task.confirmationText || '我确认由本人完成本任务所列材料的学习，并已阅读任务要求。'}}</text></label></checkbox-group>
      <button id="confirm-button" class="primary" loading="{{confirming}}" disabled="{{!accepted || confirming}}" bindtap="confirm">确认完成本次学习</button>
    </view>
    <view wx:else class="footer-note">全部材料满足固定学习规则后，可以进行本人确认。不能仅凭播放结束或翻到文档末页完成任务。</view>
  </block>
</view>
