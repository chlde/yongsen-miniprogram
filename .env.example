# Documentation only. Scripts do not automatically source this file.
# Supply these through your deployment environment; never commit actual values.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
TRAINING_DATA_DIR=/srv/yongsen-training/data
TRAINING_PUBLIC_BASE=https://training.example.com
# Production: managed TencentDB for MySQL 8.0, same region and VPC as the service.
# Replace the private host, actual port and database below. Never use local/test MySQL or a database container.
# Verify network access and MySQL 8.0/JDBC capability before using a restricted WeChat environment.
TRAINING_MYSQL_URL=jdbc:mysql://<TENCENTDB_PRIVATE_HOST>:3306/yongsen_training?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# Dedicated runtime account: required table DML only; no root, schema or account-management privileges.
# Verify TencentDB automatic backups and isolated database + media restore before release.
TRAINING_MYSQL_USER=yongsen_training
TRAINING_MYSQL_PASSWORD=
TRAINING_ADMIN_PASSWORD=
TRAINING_DATA_KEY=
TRAINING_ALLOWED_ORIGINS=
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_TOKEN=
WECHAT_CALLBACK_AES_KEY=
WECHAT_MINIPROGRAM_STATE=trial
FFPROBE_PATH=ffprobe
PDFINFO_PATH=pdfinfo
PDFTOPPM_PATH=pdftoppm
# Cloud gateway deployment uses 18874368 (18 MiB); regular local defaults remain unchanged.
TRAINING_MAX_UPLOAD_BYTES=18874368
